# ==============================================================
# SOLVYN AI & BACKEND CONFIGURATION
# ==============================================================

# GROQ API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Configurable as per Solvyn spec)
# Recommended: openai/gpt-oss-120b, llama-3.3-70b-versatile, or llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# AI Service Settings
GROQ_TIMEOUT_MS=25000
GROQ_MAX_RETRIES=3

# Clustering & Review Thresholds
# Scores >= 0.75 are merged into existing clusters
# Scores between 0.50 and 0.74 are flagged for human review
CLUSTER_CONFIDENCE_THRESHOLD=0.75
CLUSTER_REVIEW_THRESHOLD=0.50

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
